# =============================================================================
# SCHOOL CONFIGURATION TEMPLATE
# Copy this to .env and customize for your school
# =============================================================================

# School Identity
SCHOOL_NAME=Your School Name
SCHOOL_SHORT_NAME=YS
SCHOOL_EMAIL=admin@yourschool.edu
SCHOOL_WEBSITE=https://yourschool.edu
SCHOOL_ADDRESS=123 Education Street, City, Country
SCHOOL_PHONE=+1-234-567-8900

# Academic Structure (comma-separated)
GRADE_LEVELS=9,10,11,12
STREAMS=science,arts,commerce
SECTIONS=english,french,spanish
SUB_SECTIONS=A,B,C,D
TERMS=Term 1,Term 2,Term 3

# Current Academic Settings
CURRENT_ACADEMIC_YEAR=2025-2026
CURRENT_TERM=Term 1

# Calendar System Configuration
CALENDAR_SYSTEM=both
# Options: 'gregorian', 'ethiopian', 'both'
# - gregorian: Only Gregorian calendar (2025-2026)
# - ethiopian: Only Ethiopian calendar (2018-2019 E.C.)  
# - both: Support both calendar systems with conversion

PRIMARY_CALENDAR=ethiopian
# Options: 'gregorian', 'ethiopian'
# Default calendar system to display first

ENABLE_CALENDAR_CONVERSION=true
# Allow users to convert between calendar systems

# ID Prefixes (2-3 characters recommended)
STUDENT_ID_PREFIX=YS
TEACHER_ID_PREFIX=YST
REGISTRAR_ID_PREFIX=YSR
DIRECTOR_ID_PREFIX=YSD
ADMIN_ID_PREFIX=YSA
PARENT_ID_PREFIX=YSP

# System Settings
EMAIL_DOMAIN=yourschool.edu
DEFAULT_PASSWORD=welcome123
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Feature Toggles (true/false)
ENABLE_STREAMS=true
ENABLE_SECTIONS=true
ENABLE_SUB_SECTIONS=true
ENABLE_PARENT_PORTAL=true
ENABLE_RANKINGS=true
ENABLE_REGISTRATION=true
ENABLE_ETHIOPIAN_CALENDAR=true

# =============================================================================
# EXAMPLES FOR DIFFERENT EDUCATION SYSTEMS
# =============================================================================

# Example 1: US High School System
# GRADE_LEVELS=9,10,11,12
# STREAMS=regular,honors,ap
# SECTIONS=period1,period2,period3,period4,period5,period6
# SUB_SECTIONS=A,B

# Example 2: UK Secondary School System  
# GRADE_LEVELS=7,8,9,10,11,12,13
# STREAMS=gcse,alevel
# SECTIONS=house1,house2,house3,house4
# SUB_SECTIONS=1,2,3

# Example 3: Simple Elementary System
# GRADE_LEVELS=1,2,3,4,5,6
# STREAMS=
# SECTIONS=red,blue,green,yellow
# SUB_SECTIONS=
# ENABLE_STREAMS=false
# ENABLE_SUB_SECTIONS=false

# Example 4: University System
# GRADE_LEVELS=1,2,3,4
# STREAMS=engineering,business,arts,science
# SECTIONS=morning,afternoon,evening
# SUB_SECTIONS=group1,group2,group3

# Example 5: Ethiopian School System
# SCHOOL_NAME=Melka Jebdu Secondary School
# SCHOOL_SHORT_NAME=MJ
# GRADE_LEVELS=9,10,11,12
# STREAMS=natural,social
# SECTIONS=oromo,amharic,somali
# SUB_SECTIONS=A,B,C,D,E,F,G,H
# CALENDAR_SYSTEM=both
# PRIMARY_CALENDAR=ethiopian
# ENABLE_ETHIOPIAN_CALENDAR=true
# STUDENT_ID_PREFIX=MJS
# TEACHER_ID_PREFIX=MJT